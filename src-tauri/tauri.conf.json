{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stemix",
  "version": "0.1.0",
  "identifier": "app.stemix.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Stemix",
        "width": 1080,
        "height": 760,
        "minWidth": 840,
        "minHeight": 640,
        "backgroundColor": "#0b0f17",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": ["nsis"]
  }
}
